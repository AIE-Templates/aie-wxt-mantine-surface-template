# Copy to `.env` (git-ignored) and fill in. Only WXT_*-prefixed vars are exposed
# to the build — see https://wxt.dev/guide/essentials/config/environment-variables
#
# Stable Chromium extension ID: WXT injects this into the manifest `key` field
# on non-Firefox builds via the function-form manifest in wxt.config.ts
# (Firefox uses `browser_specific_settings.gecko.id`). Leave unset to let
# Chrome assign a random ID per install. Never commit the real key.
WXT_EXTENSION_KEY=
