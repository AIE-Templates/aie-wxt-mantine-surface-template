{
  "name": "aie-wxt-mantine-surface-template",
  "description": "AIE WXT + Mantine isomorphic-surface browser extension template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "audit:css": "node scripts/audit-css-vars.mjs .output/chrome-mv3/content-scripts/content.css",
    "audit:ascii": "node scripts/audit-ascii.mjs .output/chrome-mv3",
    "postinstall": "wxt prepare",
    "lint": "eslint \"**/*.{js,ts,jsx,tsx}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,jsx,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{js,ts,jsx,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mantine/colors-generator": "^9.3.1",
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@mantine/modals": "^9.3.1",
    "@mantine/notifications": "^9.3.1",
    "@webext-core/messaging": "^3.0.2",
    "@webext-core/proxy-service": "^2.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.3",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-replace": "^2.0.1",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.6.2",
    "sass-embedded": "^1.89.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wxt": "^0.20.26"
  },
  "packageManager": "pnpm@10.7.1"
}
